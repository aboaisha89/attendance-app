rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() {return request.auth != null;}
  function prof() {return get(/databases/$(database)/documents/employees/$(request.auth.uid));}
  function active() {return signed() && prof().data.status == 'active';}
  function admin() {return active() && prof().data.role in ['super_admin','admin'];}
  function hr() {return active() && prof().data.role in ['super_admin','admin','hr_manager'];}
  match /employees/{uid} {allow read: if signed() && (uid == request.auth.uid || hr());allow write: if false;}
  match /attendance/{id} {allow read: if active() && (resource.data.uid == request.auth.uid || hr());allow write: if false;}
  match /attendanceState/{uid} {allow read: if active() && uid == request.auth.uid;allow write: if false;}
  match /attendanceEvents/{id} {allow read: if active() && (resource.data.uid == request.auth.uid || hr());allow write: if false;}
  match /requests/{id} {allow read: if active() && (resource.data.uid == request.auth.uid || hr());allow write: if false;}
  match /{c}/{id} {allow read: if active() && c in ['branches','schedules','geofences','holidays','announcements','departments'];allow write: if false;}
  match /roles/{id} {allow read: if admin();allow write: if false;}
  match /systemSettings/{id} {allow read: if admin();allow write: if false;}
  match /auditLogs/{id} {allow read: if admin();allow write: if false;}
  match /{document=**} {allow read,write: if false;}
 }
}
