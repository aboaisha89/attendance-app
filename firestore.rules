rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.role in ['admin','super_admin']; }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // Signup can only create a pending employee profile. Privileged role/status fields are fixed.
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.role == 'employee';
      allow update: if isAdmin()
        || (isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName','phone','photoURL','updatedAt']));
      allow delete: if isAdmin();
    }

    match /attendance/{recordId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      // Attendance creation and mutation are server-only through callable Functions.
      allow write: if false;
    }
    match /geofences/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /schedules/{id} {
      allow read: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /requests/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
