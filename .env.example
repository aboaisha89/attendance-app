# Neon (Vercel integration adds DATABASE_URL)
DATABASE_URL=
SESSION_SECRET=
# Optional admin bootstrap for FIRST launch only. Configure securely in Vercel.
ADMIN_EMAIL=admin@attendance.local
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=

# Supabase Vercel integration: usually automatically injects one matching pair.
# Examples (don't create duplicates when integration already injects these):
# attendance_URL=https://YOUR_PROJECT.supabase.co
# attendance_SECRET_KEY=YOUR_SERVER_SECRET
# OR SUPABASE_URL and SUPABASE_SECRET_KEY
# DO NOT add secrets to NEXT_PUBLIC_ variables.
